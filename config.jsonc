{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "separator": " ",
    "key": {
      "width": 12
    }
  },
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii.txt",
    "color": {
      "1": "#d2bcfd",
      "2": "green",
      "3": "yellow",
      "4": "blue",
      "5": "magenta",
      "6": "cyan",
      "7": "white",
      "8": "red",
      "9": "magenta"
    },
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "{##948f99}┌───────{#} {##d2bcfd}>> Welcome back! << {#}{##948f99}───────┐{#}"
    },
    {
      "type": "title",
      "key": "User:",
      "format": "{##d2bcfd}{user-name}{#}{##e7e0e8}@{#}{##d2bcfd}{host-name} {#}"
    },
    {
      "type": "custom",
      "format": "{##948f99}└───────────────────────────────────┘{#}"
    },
    "break",
    {
      "type": "custom",
      "format": "{##948f99}┌────────── {#}{##cdc2db}Soft- and Hardware {#}{##948f99}──────────┐{#}"
    },
    {
      "type": "os",
      "key": "OS:",
      "keyColor": "#f0b7c5",
      "format": "{name} {version} {arch}"
    },
    {
      "type": "kernel",
      "key": "Kernel:",
      "keyColor": "#d2bcfd",
      "format": "{release}"
    },
    {
      "type": "host",
      "key": "Host:",
      "keyColor": "#ffd9e1",
      "format": "{name}"
    },
    {
      "type": "cpu",
      "key": "CPU:",
      "showPeCoreCount": true,
      "keyColor": "#d2bcfd",
      "format": "{name<29} {##948f99}"
    },
    {
      "type": "gpu",
      "key": "GPU:",
      "keyColor": "#ffd9e1",
      "format": "{name<24}      {##948f99}"
    },
    {
      "type": "memory",
      "key": "MEMORY:",
      "keyColor": "#cdc2db",
      "format": "{used} / {total} ({##d2bcfd}{percentage}{#})   {##948f99}"
    },
    {
      "type": "disk",
      "key": "DISK:",
      "keyColor": "#f0b7c5",
      "format": "{size-used} / {size-total} ({##d2bcfd}{size-percentage}{#}) {##948f99}"
    },
    {
      "type": "custom",
      "format": "{##948f99}└────────────────────────────────────────┘{#}"
    },
    "break",
    {
      "type": "custom",
      "format": "{##948f99}┌────────── {#}{##cdc2db}System Details {#}{##948f99}──────────┐{#}"
    },
    {
      "type": "display",
      "key": "DISPLAY:",
      "keyColor": "#d2bcfd",
      "format": "{width}x{height} @ {refresh-rate} Hz"
    },
    {
      "type": "uptime",
      "key": "UPTIME:",
      "keyColor": "#f0b7c5",
      "format": "{days}d {hours}h {minutes}m"
    },
    {
      "type": "disk",
      "key": "OS AGE:",
      "keyColor": "#ffd9e1",
      "folders": "/",
      "format": "{create-time:10} ({days} days)"
    },
    {
      "type": "packages",
      "key": "PACKAGES:",
      "keyColor": "#cdc2db",
      "format": "{pacman} (pacman)"
    },
    {
      "type": "localip",
      "key": "LOCAL IP:",
      "keyColor": "#d2bcfd",
      "showIpv6": false,
      "format": "{ipv4} ({ifname})"
    },
    {
      "type": "custom",
      "format": "{##948f99}└────────────────────────────────────┘{#}"
    },
    "break"
  ]
}
