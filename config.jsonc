{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "key": {
      "width": 12 // Adjust this number to increase or decrease the tab spacing
    }
  },
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii.txt",
    "color": {
      "1": "#89DCEB",
      "2": "green",
      "3": "yellow",
      "4": "blue",
      "5": "magenta",
      "6": "cyan",
      "7": "white",
      "8": "red",
      "9": "magenta"
    },
    "padding": {
      "top": 1,
      "right": 2 // keep modules closer to the logo so rows fit in narrow terminals
    }
  },
  "display": {
    "separator": " ",
    "constants": [ // not used in the code below
    "─────────────────", // {$1}
    "│", // {$2} Left/right border
    " " // {$3} Border padding 
],
    "key": {
        "width": 12
    }
  },
  "modules": [
    {
     "type": "custom", // MEOWStart
     // {#1} is equivalent to `\u001b[1m`. {#} is equivalent to `\u001b[m`
      "format": "{#90}┌───────{#} {#36}>> Welcome back! << {#}{#90}───────┐{#}"
    },    

   // "break",  
    {
      "type": "title", // User name and host
      "key": "User:",
      "format": "{##CA9EE6}{user-name}{#}{##CDD6F4}@{#}{##89DCEB}{host-name} {#}{#90}"

      //"format": "{user-name}{#90}@{#}{host-name<25}{#}{#90}",
 
 //     "format": "{user-name}{@}{host-name<35} {#90}"

    },
  //  "break",
    {
            "type": "custom", // MEOW End
            "format": "{#90}└───────────────────────────────────┘{#}"
    },
    "break",
        {
     "type": "custom", // Soft and Hardware Start
     // {#1} is equivalent to `\u001b[1m`. {#} is equivalent to `\u001b[m`
      "format": "{#90}┌────────── {#}{#32}Soft- and Hardware {#}{#90}──────────┐{#}"
    },    
    {
      "type": "os",
      "key": "OS:",
      "keyColor": "#89DCEB",
      "format": "{name} {version} {arch} {#90}│{#}" 

    },
    {
      "type": "cpu",
      "key": "CPU:",
      "showPeCoreCount": true,
      "keyColor": "#CA9EE6",
      "format": "{name<29} {#90}"
    },
    {
      "type": "gpu",
      "key": "GPU:",
      "keyColor": "#FAB387",
      "format": "{name<24}      {#90}" // somespacing was added manually here, since
                                           // it prduces two lines, given integrated and dedicated GPU...
    },
    {
      "type": "memory",
      "key": "MEMORY:",
      "keyColor": "#A6E3A1",
      "format": "{used} / {total} ({#36}{percentage}){#}   {#90}" // here as well
    },
    {
      "type": "disk",
      "key": "DISK:",
      "keyColor": "#94E2D5",
      "format": "{size-used} / {size-total} ({#36}{size-percentage}){#} {#90}"
    },
    {
            "type": "custom", // End Hardware
            "format": "{#90}└────────────────────────────────────────┘{#}"
    },
    "break",    
    {
      "type": "colors",
      "symbol": "cirlce",
      "paddingLeft": 11,
      "block":{
      "range": [1, 7] // 1:7 blocks with color range from 1 to 7
      }
    }
  ]
}
